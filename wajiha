<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AuraVault | Luxury Archive</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Inter:wght@200;400;700;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --gold: #d4af37;
            --bg: #0a0a0a;
            --card: #121212;
            --text: #ffffff;
            --border: #262626;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { background: var(--bg); color: var(--text); font-family: 'Inter', sans-serif; }

        /* Banner */
        .shipping-banner {
            background: var(--gold); color: black; text-align: center;
            padding: 10px; font-size: 0.7rem; font-weight: 800; letter-spacing: 2px;
            position: sticky; top: 0; z-index: 1000;
        }

        header { padding: 50px 20px; text-align: center; }
        .logo { font-family: 'Playfair Display', serif; font-size: 3rem; color: var(--gold); letter-spacing: 12px; text-transform: uppercase; }

        /* Navigation */
        nav { 
            display: flex; justify-content: center; gap: 15px; 
            margin-top: 30px; flex-wrap: wrap; padding: 0 10px;
        }
        .nav-link { 
            color: #888; text-transform: uppercase; font-size: 0.65rem; 
            letter-spacing: 2px; cursor: pointer; padding: 10px; transition: 0.3s;
            border-bottom: 2px solid transparent;
        }
        .nav-link.active { color: var(--gold); border-bottom: 2px solid var(--gold); }

        .container { max-width: 1300px; margin: 0 auto; padding: 40px 20px; }
        .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 35px; }

        /* Product Card */
        .card { 
            background: var(--card); border: 1px solid var(--border); 
            border-radius: 15px; padding: 20px; text-align: center; transition: 0.4s;
            position: relative;
        }
        .card:hover { border-color: var(--gold); transform: translateY(-5px); }

        .img-box { 
            position: relative; width: 100%; aspect-ratio: 4/5; 
            overflow: hidden; border-radius: 10px; margin-bottom: 15px;
        }
        .img-box img { width: 100%; height: 100%; object-fit: cover; transition: 0.6s ease; }
        .img-back { position: absolute; top: 0; left: 0; opacity: 0; }
        .card:hover .img-front { opacity: 0; }
        .card:hover .img-back { opacity: 1; }

        /* Price and Buttons */
        .price-tag { color: var(--gold); font-size: 1.4rem; font-weight: bold; margin: 10px 0; }

        .btn-stack { display: flex; flex-direction: column; gap: 8px; }
        
        /* زر الباك */
        .btn-pack {
            background: var(--gold); color: black; border: none; padding: 14px;
            border-radius: 6px; font-weight: 800; cursor: pointer; text-transform: uppercase;
            font-size: 0.75rem; letter-spacing: 1px;
        }

        /* زر القطعة الواحدة */
        .btn-single {
            background: transparent; border: 1px solid #444; color: #888; padding: 10px;
            border-radius: 6px; font-weight: 600; cursor: pointer; text-transform: uppercase;
            font-size: 0.7rem;
        }
        .btn-single:hover { border-color: var(--gold); color: var(--gold); }

        .pack-badge {
            position: absolute; top: 15px; left: 15px; background: var(--gold);
            color: black; font-size: 0.6rem; font-weight: 900; padding: 5px 10px;
            border-radius: 5px; z-index: 10;
        }
    </style>
</head>
<body>

    <div class="shipping-banner">🇺🇸 FREE SHIPPING ONLY WITHIN THE UNITED STATES 🇺🇸</div>

    <header>
        <div class="logo">AURAVAULT</div>
        <nav>
            <span class="nav-link active" onclick="loadCategory('packs.json', this)">The Packs</span>
            <span class="nav-link" onclick="loadCategory('hoody.json', this)">Hoodies</span>
            <span class="nav-link" onclick="loadCategory('tshirts.json', this)">T-Shirts</span>
            <span class="nav-link" onclick="loadCategory('sweatshirts.json', this)">Sweatshirts</span>
            <span class="nav-link" onclick="loadCategory('pants.json', this)">Pants</span>
            <span class="nav-link" onclick="loadCategory('caps.json', this)">Caps & Beanies</span>
        </nav>
    </header>

    <div class="container">
        <div id="product-grid" class="grid">
            </div>
    </div>

    <script>
        // دالة تحميل المنتجات
        async function loadCategory(file, element) {
            // تغيير الـ active link في القائمة
            if (element) {
                document.querySelectorAll('.nav-link').forEach(n => n.classList.remove('active'));
                element.classList.add('active');
            }
            
            const grid = document.getElementById('product-grid');
            grid.innerHTML = ''; 

            try {
                const response = await fetch(file);
                const data = await response.json();

                data.forEach(item => {
                    const isPackCategory = file === 'packs.json';
                    
                    grid.innerHTML += `
                        <div class="card">
                            ${isPackCategory ? '<span class="pack-badge">LIMITED PACK</span>' : ''}
                            <div class="img-box">
                                <img src="${item.imgF}" class="img-front">
                                <img src="${item.imgB}" class="img-back">
                            </div>
                            <h3 style="font-size:1rem; font-weight:400; margin-bottom:5px;">${item.title}</h3>
                            <p class="price-tag">$${isPackCategory ? item.price_pack : item.p_std}</p>
                            
                            <div class="btn-stack">
                                <button class="btn-pack" onclick="handleOrder('${item.title}', 'pack')">
                                    ${isPackCategory ? 'GET THE FULL BUNDLE' : 'ACQUIRE NOW'}
                                </button>
                                ${isPackCategory ? `
                                <button class="btn-single" onclick="handleOrder('${item.title}', 'single')">
                                    Buy Hoodie Only
                                </button>` : ''}
                            </div>
                        </div>
                    `;
                });
            } catch (e) {
                grid.innerHTML = "<p style='color:#666; text-align:center; width:100%;'>Coming Soon...</p>";
            }
        }

        function handleOrder(title, type) {
            console.log("Ordering:", title, "Type:", type);
            // غانخلو هاد البلاصة خاوية حتى نصاوبو صفحة Livraison فالمرحلة الجاية
        }

        // تحميل قسم الباكات كأول حاجة
        window.onload = () => loadCategory('packs.json');
    </script>
</body>
</html>
